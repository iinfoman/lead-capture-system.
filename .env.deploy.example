# Copy to .env.deploy (gitignored) and fill in. Used by scripts/bootstrap.sh
# and scripts/verify.sh. These stay on your machine — nothing needs pasting
# into a chat window.

# --- Supabase ---------------------------------------------------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx
# The project this app lives in (Ovibe).
SUPABASE_PROJECT_REF=bicpbpasvtvqisatiiqd

# Optional but recommended — lets the script run migrations and link the owner
# directly. Settings -> Database -> Connection string (URI), session pooler.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Email (Edge Function) --------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Leads <leads@yourdomain.co.za>
# LEAD_IP_SALT=                       # left blank, the script generates one
# APP_BASE_URL=https://your-site.netlify.app

# --- Netlify ----------------------------------------------------------------
# NETLIFY_AUTH_TOKEN=nfp_xxxxxxxxxxxx
# NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# --- First owner login (optional) -------------------------------------------
# Creates the account AND links it to a business, which is the step that is
# easy to forget — without the link the dashboard shows nothing.
# OWNER_EMAIL=you@example.co.za
# OWNER_PASSWORD=choose-something-long
# OWNER_BUSINESS_SLUG=table-mountain-plumbing
# OWNER_IS_PLATFORM_ADMIN=true
