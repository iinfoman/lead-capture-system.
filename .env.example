# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose, these ship in the browser bundle.
# Both come from the shared Ovibe Supabase project:
#   Supabase Dashboard -> Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-ovibe-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Postgres schema this app lives in inside the shared project.
# Must also be listed under Settings -> API -> Exposed schemas.
VITE_SUPABASE_SCHEMA=leadcapture

# Storage bucket for lead photos / logos / work photos.
VITE_SUPABASE_BUCKET=leadcapture-photos

# Name of the deployed lead-submission Edge Function.
VITE_SUBMIT_LEAD_FUNCTION=leadcapture-submit-lead

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`.
# NEVER put these in the frontend or commit real values.
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically
#   by the Supabase runtime; you only need to set the ones below.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
#
# Sender identity for a shared, multi-tenant function: RESEND_SENDER_ADDRESS
# is the one technical address every business sends from. Leave it unset and
# every email still shows the real business name in the display, e.g.
# "Princess Housekeeping" <onboarding@resend.dev> — built automatically from
# businesses.name, at no cost, for every tenant. Once a real domain exists
# (IONOS or otherwise), set this to a verified address on it; the per-business
# name keeps applying on top, for every tenant, at once.
# RESEND_SENDER_ADDRESS=onboarding@resend.dev
#
# RESEND_FROM is a different, blunter knob: a full "name <address>" string
# that REPLACES the per-business name for every tenant using this function.
# Only reach for it running a single business through here, or deliberately
# testing — for the normal multi-tenant case it undoes the branding above.
# RESEND_FROM="Princess Housekeeping <leads@princesshousekeeping.co.za>"
#
# LEAD_RATE_LIMIT_PER_HOUR=8
